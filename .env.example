# Where arclamp is, and the service token vibes uses with it. The token needs a
# non-empty permission list (empty means full access); vibes uses control,mint.
ARCLAMP_BASE_URL=http://127.0.0.1:8080
ARCLAMP_KEY=

# At least 32 characters; signs login cookies. `openssl rand -hex 32`
SESSION_SECRET=

# At least 32 characters; signs the scripts vibes builds for the room, so it
# knows its own shaders (and edited ones) apart. Without it, none are trusted.
# `openssl rand -hex 32`
VIBES_SIGNING_KEY=

# Where people reach vibes, comma-separated, the main one first. The RC OAuth
# callback is <main address>/auth/callback; the others log in through it.
PUBLIC_URL=http://localhost:5173

# Recurse Center OAuth app (https://www.recurse.com/settings/apps).
RC_CLIENT_ID=
RC_CLIENT_SECRET=

# Local development only: log in as any name. Refused when NODE_ENV=production.
VIBES_DEV_LOGIN=0
# With dev login: sketches (by name) whose editor says it has changes main
# hasn't, without a box to read (their "not up to date" callout).
# VIBES_FAKE_CHANGES=Glow

# Devices (a wall display) that log in with a key of their own instead of RC:
# comma-separated name=key, each key at least 32 characters (`openssl rand -hex 32`).
# A device logs in by opening <address>/auth/device?key=<key> once; changing or
# removing its key logs it out.
# VIBES_DEVICE_KEYS=portal=

# DATABASE_PATH=vibes.db
# PORT=8787

# Sketches: each a git repo (in SKETCHES_DIR, default <DATABASE_PATH's
# folder>/sketches), edited in each person's own box, a VS Code in Docker here
# (BOX_RUNNER=docker) or a pod on the cluster (kubernetes). The box image:
#   nix build .#boxImageLocal && docker load < result, then tag it vibes-box:dev
# SKETCHES=1
# BOX_IMAGE=vibes-box:dev
# BOX_IDLE_MINUTES=15
# Everyone's homes: a Docker volume by default. A folder here instead lets
# vibes see what you've changed in a sketch before it goes in the room, and
# ask whether to push it first (src/server/changes.ts).
# BOX_HOMES=/absolute/path/to/box-homes
